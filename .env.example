# Copy to .env and fill in. Never commit the real .env.

# --- Database (Postgres; Neon works well and has a free tier) ---
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# --- Cloudinary (image + video uploads) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET=""

# --- Admin login (seeded into the database) ---
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="use-a-strong-password"

# --- Session signing secret (long random string) ---
AUTH_SECRET=""

# --- Storefront contact details ---
NEXT_PUBLIC_STORE_EMAIL="orders@example.com"
NEXT_PUBLIC_STORE_WHATSAPP="+1 555 010 0000"
